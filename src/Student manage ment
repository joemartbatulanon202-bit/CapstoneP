    // =========================================================
    // LOOKUP
    // =========================================================

    private void loadLookup(
            JComboBox<LookupItem> combo,
            String sql,
            String idColumn,
            String nameColumn
    ) {

        combo.removeAllItems();

        combo.addItem(
                new LookupItem(
                        0,
                        "-- Select --"
                )
        );

        try (
                Connection connection =
                        DatabaseConnection.getConnection();

                PreparedStatement statement =
                        connection.prepareStatement(
                                sql
                        );

                ResultSet result =
                        statement.executeQuery()
        ) {

            while (
                    result.next()
            ) {

                combo.addItem(
                        new LookupItem(
                                result.getInt(
                                        idColumn
                                ),
                                result.getString(
                                        nameColumn
                                )
                        )
                );
            }

        } catch (
                SQLException ex
        ) {

            ex.printStackTrace();
        }
    }

    // =========================================================
    // INSERT STUDENT
    // =========================================================

    private void insertStudent(
            JDialog dialog,
            JTextField schoolStudentIdField,
            JTextField lrnField,
            JTextField firstNameField,
            JTextField middleNameField,
            JTextField lastNameField,
            JTextField emailField,
            JTextField contactField,
            JTextArea addressArea,
            JTextField usernameField,
            JPasswordField passwordField,
            JComboBox<LookupItem> schoolLevelCombo,
            JComboBox<LookupItem> gradeCombo,
            JComboBox<LookupItem> sectionCombo,
            JComboBox<LookupItem> programCombo,
            JComboBox<LookupItem> trackCombo,
            JComboBox<LookupItem> strandCombo,
            JComboBox<LookupItem> schoolYearCombo,
            JComboBox<String> enrollmentStatusCombo
    ) {

        String schoolStudentId =
                schoolStudentIdField
                        .getText()
                        .trim();

        String lrn =
                lrnField
                        .getText()
                        .trim();

        String firstName =
                firstNameField
                        .getText()
                        .trim();

        String middleName =
                middleNameField
                        .getText()
                        .trim();

        String lastName =
                lastNameField
                        .getText()
                        .trim();

        String email =
                emailField
                        .getText()
                        .trim();

        String username =
                usernameField
                        .getText()
                        .trim();

        String password =
                new String(
                        passwordField.getPassword()
                );

        if (
                schoolStudentId.isEmpty()
                || lrn.isEmpty()
                || firstName.isEmpty()
                || lastName.isEmpty()
                || email.isEmpty()
                || username.isEmpty()
                || password.isEmpty()
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please complete all required fields marked with *.",
                    "Missing Information",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        if (
                password.length() < 6
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Password must contain at least 6 characters.",
                    "Invalid Password",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        if (
                !email.contains("@")
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please enter a valid email address.",
                    "Invalid Email",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        Connection connection =
                null;

        try {

            connection =
                    DatabaseConnection.getConnection();

            connection.setAutoCommit(
                    false
            );

            // =================================================
            // CHECK USERNAME / EMAIL
            // =================================================

            String checkUserSql =
                    """
                    SELECT user_id

                    FROM users

                    WHERE username = ?

                       OR email = ?

                    LIMIT 1
                    """;

            try (
                    PreparedStatement check =
                            connection.prepareStatement(
                                    checkUserSql
                            )
            ) {

                check.setString(
                        1,
                        username
                );

                check.setString(
                        2,
                        email
                );

                try (
                        ResultSet result =
                                check.executeQuery()
                ) {

                    if (
                            result.next()
                    ) {

                        throw new SQLException(
                                "Username or email already exists."
                        );
                    }
                }
            }

            // =================================================
            // INSERT USER
            // =================================================

            String userSql =
                    """
                    INSERT INTO users
                    (
                        first_name,
                        middle_name,
                        last_name,
                        username,
                        email,
                        password_hash,
                        role,
                        is_active
                    )

                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        'STUDENT',
                        1
                    )
                    """;

            int userId;

            try (
                    PreparedStatement statement =
                            connection.prepareStatement(
                                    userSql,
                                    Statement.RETURN_GENERATED_KEYS
                            )
            ) {

                statement.setString(
                        1,
                        firstName
                );

                statement.setString(
                        2,
                        emptyToNull(
                                middleName
                        )
                );

                statement.setString(
                        3,
                        lastName
                );

                statement.setString(
                        4,
                        username
                );

                statement.setString(
                        5,
                        email
                );

                statement.setString(
                        6,
                        hashPassword(
                                password
                        )
                );

                statement.executeUpdate();

                try (
                        ResultSet keys =
                                statement.getGeneratedKeys()
                ) {

                    if (
                            !keys.next()
                    ) {

                        throw new SQLException(
                                "Unable to obtain generated user ID."
                        );
                    }

                    userId =
                            keys.getInt(
                                    1
                            );
                }
            }

            // =================================================
            // INSERT STUDENT
            // =================================================

            String studentSql =
                    """
                    INSERT INTO students
                    (
                        user_id,
                        school_student_id,
                        lrn,
                        contact_number,
                        address
                    )

                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?
                    )
                    """;

            int studentId;

            try (
                    PreparedStatement statement =
                            connection.prepareStatement(
                                    studentSql,
                                    Statement.RETURN_GENERATED_KEYS
                            )
            ) {

                statement.setInt(
                        1,
                        userId
                );

                statement.setString(
                        2,
                        schoolStudentId
                );

                statement.setString(
                        3,
                        lrn
                );

                statement.setString(
                        4,
                        emptyToNull(
                                contactField
                                        .getText()
                                        .trim()
                        )
                );

                statement.setString(
                        5,
                        emptyToNull(
                                addressArea
                                        .getText()
                                        .trim()
                        )
                );

                statement.executeUpdate();

                try (
                        ResultSet keys =
                                statement.getGeneratedKeys()
                ) {

                    if (
                            !keys.next()
                    ) {

                        throw new SQLException(
                                "Unable to obtain generated student ID."
                        );
                    }

                    studentId =
                            keys.getInt(
                                    1
                            );
                }
            }

            // =================================================
            // INSERT ENROLLMENT IF DATA SELECTED
            // =================================================

            LookupItem schoolYear =
                    getSelected(
                            schoolYearCombo
                    );

            LookupItem schoolLevel =
                    getSelected(
                            schoolLevelCombo
                    );

            LookupItem grade =
                    getSelected(
                            gradeCombo
                    );

            LookupItem section =
                    getSelected(
                            sectionCombo
                    );

            LookupItem program =
                    getSelected(
                            programCombo
                    );

            LookupItem track =
                    getSelected(
                            trackCombo
                    );

            LookupItem strand =
                    getSelected(
                            strandCombo
                    );

            if (
                    schoolYear != null
                    && schoolYear.id > 0
                    && schoolLevel != null
                    && schoolLevel.id > 0
                    && grade != null
                    && grade.id > 0
            ) {

                String enrollmentSql =
                        """
                        INSERT INTO enrollments
                        (
                            student_id,
                            school_year_id,
                            school_level_id,
                            grade_level_id,
                            section_id,
                            program_id,
                            track_id,
                            strand_id,
                            enrollment_status
                        )

                        VALUES
                        (
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?
                        )
                        """;

                try (
                        PreparedStatement statement =
                                connection.prepareStatement(
                                        enrollmentSql
                                )
                ) {

                    statement.setInt(
                            1,
                            studentId
                    );

                    statement.setInt(
                            2,
                            schoolYear.id
                    );

                    statement.setInt(
                            3,
                            schoolLevel.id
                    );

                    statement.setInt(
                            4,
                            grade.id
                    );

                    setNullableId(
                            statement,
                            5,
                            section
                    );

                    setNullableId(
                            statement,
                            6,
                            program
