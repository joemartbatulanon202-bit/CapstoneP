    // =========================================================
    // UPDATE STUDENT
    // =========================================================
    private void updateStudent(
            JDialog dialog,
            int studentId,
            JTextField schoolStudentIdField,
            JTextField lrnField,
            JTextField firstNameField,
            JTextField middleNameField,
            JTextField lastNameField,
            JTextField emailField,
            JTextField contactField,
            JTextArea addressArea,
            JTextField usernameField,
            JPasswordField passwordField,
            JComboBox<LookupItem> schoolLevelCombo,
            JComboBox<LookupItem> gradeCombo,
            JComboBox<LookupItem> sectionCombo,
            JComboBox<LookupItem> programCombo,
            JComboBox<LookupItem> trackCombo,
            JComboBox<LookupItem> strandCombo,
            JComboBox<LookupItem> schoolYearCombo,
            JComboBox<String> enrollmentStatusCombo
    )
    {

        String schoolStudentId =
                schoolStudentIdField
                        .getText()
                        .trim();

        String lrn =
                lrnField
                        .getText()
                        .trim();

        String firstName =
                firstNameField
                        .getText()
                        .trim();

        String middleName =
                middleNameField
                        .getText()
                        .trim();

        String lastName =
                lastNameField
                        .getText()
                        .trim();

        String email =
                emailField
                        .getText()
                        .trim();

        String username =
                usernameField
                        .getText()
                        .trim();

        String password =
                new String(
                        passwordField.getPassword()
                );

        if (
                schoolStudentId.isEmpty()
                || lrn.isEmpty()
                || firstName.isEmpty()
                || lastName.isEmpty()
                || email.isEmpty()
                || username.isEmpty()
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please complete all required fields marked with *.",
                    "Missing Information",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        Connection connection =
                null;

        try {

            connection =
                    DatabaseConnection.getConnection();

            connection.setAutoCommit(
                    false
            );

            // =================================================
            // FIND USER ID
            // =================================================

            int userId;

            String findUserSql =
                    """
                    SELECT user_id

                    FROM students

                    WHERE student_id = ?

                    LIMIT 1
                    """;

            try (
                    PreparedStatement statement =
                            connection.prepareStatement(
                                    findUserSql
                            )
            ) {

                statement.setInt(
                        1,
                        studentId
                );

                try (
                        ResultSet result =
                                statement.executeQuery()
                ) {

                    if (
                            !result.next()
                    ) {

                        throw new SQLException(
                                "Student record not found."
                        );
                    }

                    userId =
                            result.getInt(
                                    "user_id"
                            );
                }
            }

            // =================================================
            // UPDATE USER
            // =================================================

            String userSql;

            if (
                    password.isEmpty()
            ) {

                userSql =
                        """
                        UPDATE users

                        SET
                            first_name = ?,
                            middle_name = ?,
                            last_name = ?,
                            username = ?,
                            email = ?

                        WHERE user_id = ?
                        """;

            } else {

                userSql =
                        """
                        UPDATE users

                        SET
                            first_name = ?,
                            middle_name = ?,
                            last_name = ?,
                            username = ?,
                            email = ?,
                            password_hash = ?

                        WHERE user_id = ?
                        """;
            }

            try (
                    PreparedStatement statement =
                            connection.prepareStatement(
                                    userSql
                            )
            ) {

                statement.setString(
                        1,
                        firstName
                );

                statement.setString(
                        2,
                        emptyToNull(
                                middleName
                        )
                );

                statement.setString(
                        3,
                        lastName
                );

                statement.setString(
                        4,
                        username
                );

                statement.setString(
                        5,
                        email
                );

                if (
                        password.isEmpty()
                ) {

                    statement.setInt(
                            6,
                            userId
                    );

                } else {

                    statement.setString(
                            6,
                            hashPassword(
                                    password
                            )
                    );

                    statement.setInt(
                            7,
                            userId
                    );
                }

                statement.executeUpdate();
            }

            // =================================================
            // UPDATE STUDENT
            // =================================================

            String studentSql =
                    """
                    UPDATE students

                    SET
                        school_student_id = ?,
                        lrn = ?,
                        contact_number = ?,
                        address = ?

                    WHERE student_id = ?
                    """;

            try (
                    PreparedStatement statement =
                            connection.prepareStatement(
                                    studentSql
                            )
            ) {

                statement.setString(
                        1,
                        schoolStudentId
                );

                statement.setString(
                        2,
                        lrn
                );

                statement.setString(
                        3,
                        emptyToNull(
                                contactField
                                        .getText()
                                        .trim()
                        )
                );

                statement.setString(
                        4,
                        emptyToNull(
                                addressArea
                                        .getText()
                                        .trim()
                        )
                );

                statement.setInt(
                        5,
                        studentId
                );

                statement.executeUpdate();
            }

            // =================================================
            // UPDATE / INSERT ENROLLMENT
            // =================================================

            LookupItem schoolYear =
                    getSelected(
                            schoolYearCombo
                    );

            LookupItem schoolLevel =
                    getSelected(
                            schoolLevelCombo
                    );

            LookupItem grade =
                    getSelected(
                            gradeCombo
                    );

            LookupItem section =
                    getSelected(
                            sectionCombo
                    );

            LookupItem program =
                    getSelected(
                            programCombo
                    );

            LookupItem track =
                    getSelected(
                            trackCombo
                    );

            LookupItem strand =
                    getSelected(
                            strandCombo
                    );

            if (
                    schoolYear != null
                    && schoolYear.id > 0
                    && schoolLevel != null
                    && schoolLevel.id > 0
                    && grade != null
                    && grade.id > 0
            ) {

                String checkEnrollment =
                        """
                        SELECT enrollment_id

                        FROM enrollments

                        WHERE student_id = ?

                          AND school_year_id = ?

                        LIMIT 1
                        """;

                int enrollmentId =
                        0;

                try (
                        PreparedStatement statement =
                                connection.prepareStatement(
                                        checkEnrollment
                                )
                ) {

                    statement.setInt(
                            1,
                            studentId
                    );

                    statement.setInt(
                            2,
                            schoolYear.id
                    );

                    try (
                            ResultSet result =
                                    statement.executeQuery()
                    ) {

                        if (
                                result.next()
                        ) {

                            enrollmentId =
                                    result.getInt(
                                            "enrollment_id"
                                    );
                        }
                    }
                }

                if (
                        enrollmentId > 0
                ) {

                    String updateEnrollment =
                            """
                            UPDATE enrollments

                            SET
                                school_level_id = ?,
                                grade_level_id = ?,
                                section_id = ?,
                                program_id = ?,
                                track_id = ?,
                                strand_id = ?,
                                enrollment_status = ?

                            WHERE enrollment_id = ?
                            """;

                    try (
                            PreparedStatement statement =
                                    connection.prepareStatement(
                                            updateEnrollment
                                    )
                    ) {

                        statement.setInt(
                                1,
                                schoolLevel.id
                        );

                        statement.setInt(
                                2,
                                grade.id
                        );

                        setNullableId(
                                statement,
                                3,
                                section
                        );

                        setNullableId(
                                statement,
                                4,
                                program
                        );

                        setNullableId(
                                statement,
                                5,
                                track
                        );

                        setNullableId(
                                statement,
                                6,
                                strand
                        );

                        statement.setString(
                                7,
                                enrollmentStatusCombo
                                        .getSelectedItem()
                                        .toString()
                        );

                        statement.setInt(
                                8,
                                enrollmentId
                        );

                        statement.executeUpdate();
                    }

                } else {

                    String insertEnrollment =
                            """
                            INSERT INTO enrollments
                            (
                                student_id,
                                school_year_id,
                                school_level_id,
                                grade_level_id,
                                section_id,
                                program_id,
                                track_id,
                                strand_id,
                                enrollment_status
                            )

                            VALUES
                            (
                                ?,
                                ?,
                                ?,
                                ?,
                                ?,
                                ?,
                                ?,
                                ?,
                                ?
                            )
                            """;

                    try (
                            PreparedStatement statement =
                                    connection.prepareStatement(
                                            insertEnrollment
                                    )
                    ) {

                        statement.setInt(
                                1,
                                studentId
                        );

                        statement.setInt(
                                2,
                                schoolYear.id
                        );

                        statement.setInt(
                                3,
                                schoolLevel.id
                        );

                        statement.setInt(
                                4,
                                grade.id
                        );

                        setNullableId(
                                statement,
                                5,
                                section
                        );

                        setNullableId(
                                statement,
                                6,
                                program
                        );

                        setNullableId(
                                statement,
                                7,
                                track
                        );

                        setNullableId(
                                statement,
                                8,
                                strand
                        );

                        statement.setString(
                                9,
                                enrollmentStatusCombo
                                        .getSelectedItem()
                                        .toString()
                        );

                        statement.executeUpdate();
                    }
                }
            }

            connection.commit();

            dialog.dispose();

            loadStudents();

            setStatus(
                    "Student information successfully updated."
            );

            JOptionPane.showMessageDialog(
                    this,
                    "Student information successfully updated.",
                    "Update Successful",
                    JOptionPane.INFORMATION_MESSAGE
            );

        } catch (
                SQLException ex
        ) {

            try {

                if (
                        connection != null
                ) {

                    connection.rollback();
                }

            } catch (
                    SQLException rollbackEx
            ) {

                rollbackEx.printStackTrace();
            }

            JOptionPane.showMessageDialog(
                    this,
                    "Unable to update student.\n\n"
                            + ex.getMessage(),
                    "Database Error",
                    JOptionPane.ERROR_MESSAGE
            );

            ex.printStackTrace();

        } finally {

            try {

                if (
                        connection != null
                ) {

                    connection.setAutoCommit(
                            true
                    );

                    connection.close();
                }

            } catch (
                    SQLException closeEx
            ) {

                closeEx.printStackTrace();
            }
        }
    }

