    private void changeStudentStatus() {

        int viewRow =
                studentTable.getSelectedRow();

        if (
                viewRow == -1
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please select a student first.",
                    "Student Status",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        int modelRow =
                studentTable
                        .convertRowIndexToModel(
                                viewRow
                        );

        int studentId =
                Integer.parseInt(
                        tableModel
                                .getValueAt(
                                        modelRow,
                                        0
                                )
                                .toString()
                );

        String currentStatus =
                tableModel
                        .getValueAt(
                                modelRow,
                                15
                        )
                        .toString();

        boolean active =
                "ACTIVE".equalsIgnoreCase(
                        currentStatus
                );

        String action =
                active
                        ? "deactivate"
                        : "activate";

        int choice =
                JOptionPane.showConfirmDialog(
                        this,
                        "Are you sure you want to "
                                + action
                                + " this student?",
                        "Change Student Status",
                        JOptionPane.YES_NO_OPTION,
                        JOptionPane.QUESTION_MESSAGE
                );

        if (
                choice != JOptionPane.YES_OPTION
        ) {

            return;
        }

        String sql =
                """
                UPDATE users

                SET is_active = ?

                WHERE user_id = (

                    SELECT user_id

                    FROM students

                    WHERE student_id = ?
                )
                """;

        try (
                Connection connection =
                        DatabaseConnection.getConnection();

                PreparedStatement statement =
                        connection.prepareStatement(
                                sql
                        )
        ) {

            statement.setInt(
                    1,
                    active ? 0 : 1
            );

            statement.setInt(
                    2,
                    studentId
            );

            int affected =
                    statement.executeUpdate();

            if (
                    affected > 0
            ) {

                loadStudents();

                setStatus(
                        "Student account status updated."
                );

                JOptionPane.showMessageDialog(
                        this,
                        "Student account successfully "
                                + (active
                                ? "deactivated."
                                : "activated."),
                        "Success",
                        JOptionPane.INFORMATION_MESSAGE
                );

            } else {

                JOptionPane.showMessageDialog(
                        this,
                        "No student record was updated.",
                        "Update Failed",
                        JOptionPane.WARNING_MESSAGE
                );
            }

        } catch (
                SQLException ex
        ) {

            JOptionPane.showMessageDialog(
                    this,
                    "Unable to update student status.\n\n"
                            + ex.getMessage(),
                    "Database Error",
                    JOptionPane.ERROR_MESSAGE
            );

            ex.printStackTrace();
        }
    }

