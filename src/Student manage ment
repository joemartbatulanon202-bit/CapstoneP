    // =========================================================
    // LOAD STUDENTS SEARCH
    // =========================================================

    private void loadStudents(
            String keyword
    ) {

        tableModel.setRowCount(
                0
        );

        String sql =
                """
                SELECT

                    s.student_id,

                    s.school_student_id,

                    s.lrn,

                    CONCAT(
                        u.first_name,
                        ' ',
                        COALESCE(
                            CONCAT(
                                u.middle_name,
                                ' '
                            ),
                            ''
                        ),
                        u.last_name
                    ) AS full_name,

                    COALESCE(
                        u.email,
                        '-'
                    ) AS email,

                    COALESCE(
                        s.contact_number,
                        '-'
                    ) AS contact_number,

                    COALESCE(
                        s.address,
                        '-'
                    ) AS address,

                    COALESCE(
                        gl.grade_name,
                        'Not Enrolled'
                    ) AS grade_name,

                    COALESCE(
                        sec.section_name,
                        'Not Assigned'
                    ) AS section_name,

                    COALESCE(
                        sl.level_name,
                        'Not Assigned'
                    ) AS level_name,

                    COALESCE(
                        p.program_name,
                        '-'
                    ) AS program_name,

                    COALESCE(
                        t.track_name,
                        '-'
                    ) AS track_name,

                    COALESCE(
                        st.strand_name,
                        '-'
                    ) AS strand_name,

                    COALESCE(
                        sy.school_year,
                        '-'
                    ) AS school_year,

                    COALESCE(
                        e.enrollment_status,
                        'NO ENROLLMENT'
                    ) AS enrollment_status,

                    CASE
                        WHEN u.is_active = 1
                        THEN 'ACTIVE'
                        ELSE 'INACTIVE'
                    END AS account_status

                FROM students s

                INNER JOIN users u
                    ON s.user_id = u.user_id

                LEFT JOIN enrollments e
                    ON s.student_id = e.student_id

                    AND (
                        e.school_year_id = (
                            SELECT
                                sy2.school_year_id

                            FROM school_years sy2

                            WHERE sy2.is_current = 1

                            ORDER BY
                                sy2.school_year_id DESC

                            LIMIT 1
                        )

                        OR e.school_year_id IS NULL
                    )

                LEFT JOIN school_years sy
                    ON e.school_year_id =
                       sy.school_year_id

                LEFT JOIN school_levels sl
                    ON e.school_level_id =
                       sl.school_level_id

                LEFT JOIN grade_levels gl
                    ON e.grade_level_id =
                       gl.grade_level_id

                LEFT JOIN programs p
                    ON e.program_id =
                       p.program_id

                LEFT JOIN tracks t
                    ON e.track_id =
                       t.track_id

                LEFT JOIN strands st
                    ON e.strand_id =
                       st.strand_id

                LEFT JOIN sections sec
                    ON e.section_id =
                       sec.section_id

                WHERE

                    (
                        ? = ''

                        OR s.school_student_id LIKE ?

                        OR s.lrn LIKE ?

                        OR u.first_name LIKE ?

                        OR u.middle_name LIKE ?

                        OR u.last_name LIKE ?

                        OR CONCAT(
                            u.first_name,
                            ' ',
                            u.last_name
                        ) LIKE ?

                        OR u.email LIKE ?

                        OR s.contact_number LIKE ?

                        OR s.address LIKE ?

                        OR gl.grade_name LIKE ?

                        OR sec.section_name LIKE ?

                        OR sl.level_name LIKE ?

                        OR p.program_name LIKE ?

                        OR t.track_name LIKE ?

                        OR st.strand_name LIKE ?
                    )

                ORDER BY

                    u.last_name ASC,

                    u.first_name ASC
                """;

        String search =
                keyword == null
                        ? ""
                        : keyword.trim();

        String pattern =
                "%"
                        + search
                        + "%";

        try (
                Connection connection =
                        DatabaseConnection.getConnection();

                PreparedStatement statement =
                        connection.prepareStatement(
                                sql
                        )
        ) {

            statement.setString(
                    1,
                    search
            );

            for (
                    int i = 2;
                    i <= 16;
                    i++
            ) {

                statement.setString(
                        i,
                        pattern
                );
            }

            try (
                    ResultSet result =
                            statement.executeQuery()
            ) {

                while (
                        result.next()
                ) {

                    tableModel.addRow(
                            new Object[] {

                                    result.getInt(
                                            "student_id"
                                    ),

                                    result.getString(
                                            "school_student_id"
                                    ),

                                    result.getString(
                                            "lrn"
                                    ),

                                    result.getString(
                                            "full_name"
                                    ),

                                    result.getString(
                                            "email"
                                    ),

                                    result.getString(
                                            "contact_number"
                                    ),

                                    result.getString(
                                            "address"
                                    ),

                                    result.getString(
                                            "grade_name"
                                    ),

                                    result.getString(
                                            "section_name"
                                    ),

                                    result.getString(
                                            "level_name"
                                    ),

                                    result.getString(
                                            "program_name"
                                    ),

                                    result.getString(
                                            "track_name"
                                    ),

                                    result.getString(
                                            "strand_name"
                                    ),

                                    result.getString(
                                            "school_year"
                                    ),

                                    result.getString(
                                            "enrollment_status"
                                    ),

                                    result.getString(
                                            "account_status"
                                    )
                            }
                    );
                }
            }

            updateRecordCount();

            if (
                    search.isEmpty()
            ) {

                setStatus(
                        "Student records loaded."
                );

            } else {

                setStatus(
                        "Search completed."
                );
            }

        } catch (
                SQLException ex
        ) {

            setStatus(
                    "Unable to load student records."
            );

            JOptionPane.showMessageDialog(
                    this,
                    "Unable to load student records.\n\n"
                            + ex.getMessage(),
                    "Database Error",
                    JOptionPane.ERROR_MESSAGE
            );

            ex.printStackTrace();
        }
    }

