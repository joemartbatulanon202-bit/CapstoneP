            if (success) {

                JOptionPane.showMessageDialog(
                        this,
                        "Section has been deactivated.",
                        "Section Management",
                        JOptionPane.INFORMATION_MESSAGE
                );

                loadSections();

                clearForm();

            } else {

                showError(
                        "The section could not be deactivated."
