    ) {

        for (String methodName : methods) {

            String value =
                    invokeStringGetter(
                            object,
                            methodName
                    );

            if (value != null) {

                return value;
            }
        }

        return "";
    }

    // ============================================================
    // INTEGER PROPERTY
    // ============================================================

    private int getIntProperty(
            Object object,
            String... methods
    ) {

        for (String methodName : methods) {

            Integer value =
                    invokeIntegerGetter(
                            object,
                            methodName
                    );

            if (value != null) {

                return value;
            }
        }

        return 0;
    }

    // ============================================================
    // BOOLEAN PROPERTY
    // ============================================================

    private boolean getBooleanProperty(
            Object object,
            String... methods
    ) {

        for (String methodName : methods) {

            try {

                Method method =
                        object.getClass()
                                .getMethod(
                                        methodName
                                );

                Object value =
                        method.invoke(
                                object
                        );

                if (value instanceof Boolean) {

                    return (Boolean) value;
                }

            } catch (Exception ignored) {
            }
        }

        return true;
    }

