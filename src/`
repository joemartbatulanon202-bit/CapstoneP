    // ============================================================
    // SERVICE COMBO LOADER
    // ============================================================

    @SuppressWarnings("unchecked")
    private void loadComboFromService(
            JComboBox<IdNameItem> combo,
            String methodName
    ) {

        combo.removeAllItems();

        combo.addItem(
                new IdNameItem(
                        0,
                        "Select..."
                )
        );

        if (sectionService == null) {
            return;
        }

        try {

            Method method =
                    findNoArgumentMethod(
                            sectionService.getClass(),
                            methodName
                    );

            if (method == null) {
                return;
            }

            Object result =
                    method.invoke(
                            sectionService
                    );

            if (result instanceof List<?>) {

                List<?> list =
                        (List<?>) result;

                for (Object object : list) {

                    IdNameItem item =
                            convertToIdNameItem(
                                    object
                            );

                    if (item != null) {

                        combo.addItem(
                                item
                        );
                    }
                }
            }

        } catch (Exception ex) {

            System.err.println(
                    "Unable to load "
                            + methodName
                            + ": "
                            + ex.getMessage()
            );
        }
    }

    // ============================================================
    // FIND METHOD
    // ============================================================

    private Method findNoArgumentMethod(
            Class<?> type,
            String methodName
    ) {

        try {

            return type.getMethod(
                    methodName
            );

        } catch (NoSuchMethodException ex) {

            return null;
        }
    }

    // ============================================================
    // CONVERT OBJECT TO ID/NAME
    // ============================================================

    private IdNameItem convertToIdNameItem(
            Object object
    ) {

        if (object == null) {
            return null;
        }

        if (object instanceof IdNameItem) {

            return (IdNameItem) object;
        }

        try {

            Integer id =
                    invokeIntegerGetter(
                            object,
                            "getId"
                    );

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getSchoolYearId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getSchoolLevelId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getGradeLevelId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getProgramId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getTrackId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getStrandId"
                        );
            }

            if (id == null) {

                id =
                        invokeIntegerGetter(
                                object,
                                "getUserId"
                        );
            }

            if (id == null) {

                return null;
            }

            String name =
                    invokeStringGetter(
                            object,
                            "getName"
                    );

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getSchoolYear"
                        );
            }

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getSchoolLevel"
                        );
            }

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getGradeLevel"
                        );
            }

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getProgramName"
                        );
            }

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getTrackName"
                        );
            }

            if (name == null) {

                name =
                        invokeStringGetter(
                                object,
                                "getStrandName"
                        );
            }

            if (name == null) {

                name =
                        object.toString();
            }

            return new IdNameItem(
                    id,
                    name
            );

        } catch (Exception ex) {

            return null;
        }
    }

    // ============================================================
    // INTEGER GETTER
    // ============================================================

    private Integer invokeIntegerGetter(
            Object object,
            String methodName
    ) {

        try {

            Method method =
                    object.getClass()
                            .getMethod(
                                    methodName
                            );

            Object value =
                    method.invoke(
                            object
                    );

            if (value instanceof Number) {

                return ((Number) value).intValue();
            }

        } catch (Exception ignored) {
        }

        return null;
    }

    // ============================================================
    // STRING GETTER
    // ============================================================

    private String invokeStringGetter(
            Object object,
            String methodName
    ) {

        try {

            Method method =
                    object.getClass()
                            .getMethod(
                                    methodName
                            );

            Object value =
                    method.invoke(
                            object
                    );

            if (value != null) {

                return String.valueOf(
                        value
                );
            }

        } catch (Exception ignored) {
        }

        return null;
    }

