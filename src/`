    // ============================================================
    // OPEN FRAME
    // ============================================================

    private void openFrame(
            String className
    ) {

        try {

            Class<?> frameClass =
                    Class.forName(
                            className
                    );

            JFrame frame =
                    createFrameInstance(
                            frameClass
                    );

            if (frame == null) {

                showWarning(
                        "Unable to open:\n\n"
                                + className
                );

                return;
            }

            frame.setLocationRelativeTo(
                    this
            );

            frame.setVisible(
                    true
            );

            dispose();

        } catch (ClassNotFoundException ex) {

            showWarning(
                    "The following frame has not been created yet:\n\n"
                            + className
            );

        } catch (Exception ex) {

            showError(
                    "Unable to open the selected module.\n\n"
                            + ex.getMessage()
            );

            ex.printStackTrace();
        }
    }

    // ============================================================
    // CREATE FRAME INSTANCE
    // ============================================================

    private JFrame createFrameInstance(
            Class<?> frameClass
    ) {

        // --------------------------------------------------------
        // Constructor(int)
        // --------------------------------------------------------

        try {

            Constructor<?> constructor =
                    frameClass.getConstructor(
                            int.class
                    );

            Object object =
                    constructor.newInstance(
                            adminUserId
                    );

            if (object instanceof JFrame) {

                return (JFrame) object;
            }

        } catch (NoSuchMethodException ignored) {

        } catch (Exception ex) {

            ex.printStackTrace();

            return null;
        }

        // --------------------------------------------------------
        // Constructor(Integer)
        // --------------------------------------------------------

        try {

            Constructor<?> constructor =
                    frameClass.getConstructor(
                            Integer.class
                    );

            Object object =
                    constructor.newInstance(
                            adminUserId
                    );

            if (object instanceof JFrame) {

                return (JFrame) object;
            }

        } catch (NoSuchMethodException ignored) {

        } catch (Exception ex) {

            ex.printStackTrace();

            return null;
        }

        // --------------------------------------------------------
        // Constructor()
        // --------------------------------------------------------

        try {

            Constructor<?> constructor =
                    frameClass.getConstructor();

            Object object =
                    constructor.newInstance();

            if (object instanceof JFrame) {

                return (JFrame) object;
            }

        } catch (Exception ex) {

            ex.printStackTrace();
        }

        return null;
    }

