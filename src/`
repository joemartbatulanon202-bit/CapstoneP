    // ============================================================
    // SET OBJECT PROPERTY
    // ============================================================

    private void setObjectProperty(
            Object object,
            String methodName,
            Object value
    ) {

        if (object == null) {
            return;
        }

        try {

            for (Method method :
                    object.getClass()
                            .getMethods()) {

                if (!method.getName()
                        .equals(methodName)) {

                    continue;
                }

                if (method.getParameterCount()
                        != 1) {

                    continue;
                }

                Class<?> parameterType =
                        method.getParameterTypes()[0];

                if (value == null
                        || isCompatible(
                                parameterType,
                                value.getClass()
                        )) {

                    method.invoke(
                            object,
                            value
                    );

                    return;
                }

                if (parameterType == int.class
                        && value instanceof Number) {

                    method.invoke(
                            object,
                            ((Number) value).intValue()
                    );

                    return;
                }

            }

        } catch (Exception ex) {

            System.err.println(
                    "Property setter error "
                            + methodName
                            + ": "
                            + ex.getMessage()
            );
        }
    }

    // ============================================================
    // SET OBJECT ID PROPERTY
    // ============================================================

    private void setObjectIdProperty(
            Object object,
            String methodName,
            JComboBox<IdNameItem> combo
    ) {

        IdNameItem item =
                getSelectedItem(
                        combo
                );

        if (item == null
                || item.getId() <= 0) {

            return;
        }

        setObjectProperty(
                object,
                methodName,
                item.getId()
        );
    }

    // ============================================================
    // COMPATIBLE TYPE
    // ============================================================

    private boolean isCompatible(
            Class<?> target,
            Class<?> source
    ) {

        if (target.isAssignableFrom(
                source
        )) {

            return true;
        }

        if (target == int.class
                && Integer.class
                        .isAssignableFrom(
                                source
                        )) {

            return true;
        }

        if (target == long.class
                && Long.class
                        .isAssignableFrom(
                                source
                        )) {

            return true;
        }

        if (target == boolean.class
                && Boolean.class
                        .isAssignableFrom(
                                source
                        )) {

            return true;
        }

        return false;
    }

    // ============================================================
    // INVOKE SAVE
    // ============================================================

    private boolean invokeSaveMethod(
            Section section
    ) throws Exception {

        String[] names = {
                "createSection",
                "addSection",
                "saveSection",
                "insertSection"
        };

        for (String name : names) {

            Method method =
                    findOneParameterMethod(
                            name
                    );

            if (method != null) {

                Object result =
                        method.invoke(
                                sectionService,
                                section
                        );

                return result == null
                        || Boolean.TRUE.equals(
                                result
                        );
            }
        }

        throw new NoSuchMethodException(
                "No section create/save method found in SectionService."
        );
    }

    // ============================================================
    // INVOKE UPDATE
    // ============================================================

    private boolean invokeUpdateMethod(
            Section section
    ) throws Exception {

        String[] names = {
                "updateSection",
                "saveSection"
        };

        for (String name : names) {

            Method method =
                    findOneParameterMethod(
                            name
                    );

            if (method != null) {

                Object result =
                        method.invoke(
                                sectionService,
                                section
                        );

                return result == null
                        || Boolean.TRUE.equals(
                                result
                        );
            }
        }

        throw new NoSuchMethodException(
                "No section update method found in SectionService."
        );
    }

    // ============================================================
    // INVOKE DELETE
    // ============================================================

    private boolean invokeDeleteMethod(
            int sectionId
    ) throws Exception {

        String[] names = {
                "deleteSection",
                "deactivateSection",
                "removeSection"
        };

        for (String name : names) {

            for (Method method :
                    sectionService.getClass()
                            .getMethods()) {

                if (!method.getName()
                        .equals(name)) {

                    continue;
                }

                if (method.getParameterCount()
                        != 1) {

                    continue;
                }

                Class<?> parameter =
                        method.getParameterTypes()[0];

                Object result;

                if (parameter == int.class
                        || parameter == Integer.class) {

                    result =
                            method.invoke(
                                    sectionService,
                                    sectionId
                            );

                } else if (parameter == long.class
                        || parameter == Long.class) {

                    result =
                            method.invoke(
                                    sectionService,
                                    (long) sectionId
                            );

                } else {

                    continue;
                }

                return result == null
                        || Boolean.TRUE.equals(
                                result
                        );
            }
        }

        throw new NoSuchMethodException(
                "No section delete/deactivate method found."
        );
    }

    // ============================================================
    // FIND ONE PARAMETER METHOD
    // ============================================================

    private Method findOneParameterMethod(
            String name
    ) {

        for (Method method :
                sectionService.getClass()
                        .getMethods()) {

            if (method.getName()
                    .equals(name)
                    && method.getParameterCount()
                    == 1) {

                return method;
            }
        }

        return null;
    }

