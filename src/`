    private void selectComboByText(
            JComboBox<IdNameItem> combo,
            String text
    ) {

        if (combo == null
                || text == null
                || text.trim().isEmpty()) {

            return;
        }

        for (int i = 0;
                i < combo.getItemCount();
                i++) {

            IdNameItem item =
                    combo.getItemAt(i);

