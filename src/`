                            MouseEvent e
                    ) {

                        button.setBackground(
                                background
                        );
                    }
                }
        );
    }

    // ============================================================
    // HOVER COLOR
    // ============================================================

    private Color getHoverColor(
            Color color
    ) {

        int r =
                Math.max(
                        color.getRed() - 20,
                        0
                );

        int g =
                Math.max(
                        color.getGreen() - 20,
                        0
                );

        int b =
                Math.max(
                        color.getBlue() - 20,
                        0
                );

        return new Color(
                r,
                g,
                b
        );
    }

