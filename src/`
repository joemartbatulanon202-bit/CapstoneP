    // ============================================================
    // ADD SECTION
    // ============================================================

    private void addSection() {

        if (!validateForm()) {
            return;
        }

        if (sectionService == null) {

            showError(
                    "SectionService is not available."
            );

            return;
        }

        try {

            Section section =
                    buildSectionFromForm();

            boolean success =
                    invokeSaveMethod(
                            section
                    );

            if (success) {

                JOptionPane.showMessageDialog(
                        this,
                        "Section has been added successfully.",
                        "Section Management",
                        JOptionPane.INFORMATION_MESSAGE
                );

                loadSections();

                clearForm();

            } else {

                showError(
                        "The section could not be added."
                );
            }

        } catch (Exception ex) {

            showError(
                    "Unable to add section.\n\n"
                            + ex.getMessage()
            );
        }
    }

    // ============================================================
    // UPDATE SECTION
    // ============================================================

    private void updateSection() {

        if (selectedSectionId <= 0) {

            showWarning(
                    "Please select a section first."
            );

            return;
        }

        if (!validateForm()) {
            return;
        }

        if (sectionService == null) {

            showError(
                    "SectionService is not available."
            );

            return;
        }

        int choice =
                JOptionPane.showConfirmDialog(
                        this,
                        "Update the selected section?",
                        "Confirm Update",
                        JOptionPane.YES_NO_OPTION,
                        JOptionPane.QUESTION_MESSAGE
                );

        if (choice != JOptionPane.YES_OPTION) {
            return;
        }

        try {

            Section section =
                    buildSectionFromForm();

            setSectionId(
                    section,
                    selectedSectionId
            );

            boolean success =
                    invokeUpdateMethod(
                            section
                    );

            if (success) {

                JOptionPane.showMessageDialog(
                        this,
                        "Section has been updated successfully.",
                        "Section Management",
                        JOptionPane.INFORMATION_MESSAGE
                );

                loadSections();

                clearForm();

            } else {

                showError(
                        "The section could not be updated."
                );
            }

        } catch (Exception ex) {

            showError(
                    "Unable to update section.\n\n"
                            + ex.getMessage()
            );
        }
    }

    // ============================================================
    // DELETE / DEACTIVATE SECTION
    // ============================================================

    private void deleteSection() {

        if (selectedSectionId <= 0) {

            showWarning(
                    "Please select a section first."
            );

            return;
        }

        if (sectionService == null) {

            showError(
                    "SectionService is not available."
            );

            return;
        }

        int choice =
                JOptionPane.showConfirmDialog(
                        this,
                        "Are you sure you want to deactivate this section?",
                        "Confirm Deactivation",
                        JOptionPane.YES_NO_OPTION,
                        JOptionPane.WARNING_MESSAGE
                );

        if (choice != JOptionPane.YES_OPTION) {
            return;
        }

        try {

            boolean success =
                    invokeDeleteMethod(
