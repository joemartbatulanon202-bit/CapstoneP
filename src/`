    // ============================================================
    // LOAD SECTIONS
    // ============================================================

    private void loadSections() {

        if (tableModel == null) {
            return;
        }

        tableModel.setRowCount(0);

        List<?> sections =
                Collections.emptyList();

        if (sectionService != null) {

            try {

                Method method =
                        findSectionListMethod();

                if (method != null) {

                    Object result;

                    if (method.getParameterCount() == 0) {

                        result =
                                method.invoke(
                                        sectionService
                                );

                    } else {

                        result =
                                method.invoke(
                                        sectionService,
                                        getSearchText()
                                );
                    }

                    if (result instanceof List<?>) {

                        sections =
                                (List<?>) result;
                    }
                }

            } catch (Exception ex) {

                System.err.println(
                        "Section loading error: "
                                + ex.getMessage()
                );
            }
        }

        for (Object object : sections) {

            addSectionToTable(
                    object
            );
        }

        recordCountLabel.setText(
                tableModel.getRowCount()
                        + " section"
                        + (
                                tableModel.getRowCount() == 1
                                        ? ""
                                        : "s"
                        )
        );
    }

    // ============================================================
    // FIND SECTION LIST METHOD
    // ============================================================

    private Method findSectionListMethod() {

        String[] names = {
                "getAllSections",
                "findAll",
                "getSections",
                "searchSections"
        };

        for (String name : names) {

            for (Method method :
                    sectionService.getClass()
                            .getMethods()) {

                if (!method.getName().equals(name)) {
                    continue;
                }

                Class<?> returnType =
                        method.getReturnType();

                if (List.class.isAssignableFrom(
                        returnType
                )) {

                    if (method.getParameterCount() == 0
                            || method.getParameterCount() == 1) {

                        return method;
                    }
                }
            }
        }

        return null;
    }

    // ============================================================
    // SEARCH TEXT
    // ============================================================

    private String getSearchText() {

        if (searchField == null) {
            return "";
        }

        String text =
                searchField.getText();

        if (text == null) {
            return "";
        }

        return text.trim();
    }

    // ============================================================
    // ADD OBJECT TO TABLE
    // ============================================================

    private void addSectionToTable(
            Object object
    ) {

        if (object == null) {
            return;
        }

        try {

            int id =
                    getIntProperty(
                            object,
                            "getSectionId",
                            "getId"
                    );

            String sectionName =
                    getStringProperty(
                            object,
                            "getSectionName",
                            "getName"
                    );

            String roomName =
                    getStringProperty(
                            object,
                            "getRoomName"
                    );

            String grade =
                    getStringProperty(
                            object,
                            "getGradeLevelName",
                            "getGradeLevel"
                    );

            String level =
                    getStringProperty(
                            object,
                            "getSchoolLevelName",
                            "getSchoolLevel"
                    );

            String program =
                    getStringProperty(
                            object,
                            "getProgramName",
                            "getProgram"
                    );

            String track =
                    getStringProperty(
                            object,
                            "getTrackName",
                            "getTrack"
                    );

            String strand =
                    getStringProperty(
                            object,
                            "getStrandName",
                            "getStrand"
                    );

            String adviser =
                    getStringProperty(
                            object,
                            "getAdviserName",
                            "getTeacherName",
                            "getAdviser"
                    );

            boolean active =
                    getBooleanProperty(
                            object,
                            "isActive",
                            "getActive"
                    );

            String status =
                    active
                            ? "ACTIVE"
                            : "INACTIVE";

            String search =
                    getSearchText()
                            .toLowerCase();

            String combined =
                    (
                            safe(sectionName)
                                    + " "
                                    + safe(roomName)
                    ).toLowerCase();

            if (!search.isEmpty()
                    && !combined.contains(search)) {

                return;
            }

            String selectedStatus =
                    statusCombo == null
                            ? "ALL"
                            : String.valueOf(
                                    statusCombo.getSelectedItem()
                            );

            if ("ACTIVE".equals(
                    selectedStatus
            ) && !active) {

                return;
            }

            if ("INACTIVE".equals(
                    selectedStatus
            ) && active) {

                return;
            }

            tableModel.addRow(
                    new Object[] {
                            id,
                            safe(sectionName),
                            safe(roomName),
                            safe(grade),
                            safe(level),
                            safe(program),
                            safe(track),
                            safe(strand),
                            safe(adviser),
                            status
                    }
            );

        } catch (Exception ex) {

            System.err.println(
                    "Unable to display section: "
                            + ex.getMessage()
            );
        }
    }

