                                true
                        );

                    } catch (Exception ex) {

                        ex.printStackTrace();

                        JOptionPane.showMessageDialog(
                                null,
                                "Unable to start Section Management.\n\n"
                                        + ex.getMessage(),
                                "LNHS Attendance System",
                                JOptionPane.ERROR_MESSAGE
                        );
                    }
                }
        );
    }
}

